   "source": [
    "def profile_data(df_dict, name='Train/Dev/Test'):\n",
    "    \"\"\"Generate basic statistics for each split.\"\"\"\n",
    "    print(f'\\n=== {name} Data Profile ===')\n",
    "    for split_name, df in df_dict.items():\n",
    "        print(f'\\n{split_name.upper()} ({len(df)} rows):')\n",
    "        print(f'  Columns: {df.shape[1]}')\n",
    "        print(f'  Missing values:')\n",
    "        missing = df.isnull().sum()\n",
    "        for col, count in missing[missing > 0].items():\n",
    "            pct = 100 * count / len(df)\n",
    "            print(f'    {col}: {count} ({pct:.1f}%)')\n",
    "        if 'label' in df.columns:\n",
    "            print(f'  Class distribution:')\n",
    "            print(f'    Benign (0): {(df[\"label\"]==0).sum()} ({100*(df[\"label\"]==0).mean():.1f}%)')\n",
    "            print(f'    Malignant (1): {(df[\"label\"]==1).sum()} ({100*(df[\"label\"]==1).mean():.1f}%)')\n",
    "        if 'age' in df.columns:\n",
    "            print(f'  Age stats: min={df[\"age\"].min():.0f}, max={df[\"age\"].max():.0f}, median={df[\"age\"].median():.0f}')\n",
    "        if 'sex' in df.columns:\n",
    "            print(f'  Sex distribution: {df[\"sex\"].value_counts().to_dict()}')\n",
    "        if 'localization' in df.columns:\n",
    "            print(f'  Top 5 locations: {df[\"localization\"].value_counts().head(5).to_dict()}')\n",
    "\n",
    "profile_data({'train': train_df, 'dev': dev_df, 'test': test_df})"
   ]
  },
