  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_data_from_gcs(bucket, prefix, split_names=['train', 'dev', 'test']):\n",
    "    \"\"\"Load train/dev/test parquet files from GCS.\"\"\"\n",
    "    data = {}\n",
    "    for split in split_names:\n",
    "        path = f'gs://{bucket}/{prefix}/sharded/{split}.parquet'\n",
    "        try:\n",
    "            df = pd.read_parquet(path)\n",
    "            data[split] = df\n",
    "            print(f'✓ Loaded {split} ({len(df)} rows) from GCS')\n",
    "        except Exception as e:\n",
    "            print(f'✗ Failed to load {split} from GCS: {e}')\n",
    "    return data\n",
    "\n",
    "def load_data_from_local(data_dir, split_names=['train', 'dev', 'test']):\n",
    "    \"\"\"Load train/dev/test parquet files from local directory.\"\"\"\n",
    "    data = {}\n",
    "    data_path = Path(data_dir)\n",
    "    for split in split_names:\n",
    "        file_path = data_path / f'{split}.parquet'\n",
    "        try:\n",
    "            df = pd.read_parquet(file_path)\n",
    "            data[split] = df\n",
    "            print(f'✓ Loaded {split} ({len(df)} rows) from local')\n",
    "        except Exception as e:\n",
    "            print(f'✗ Failed to load {split} from local: {e}')\n",
    "    return data\n",
    "\n",
    "# Load data\n",
    "if DATA_SOURCE == 'gcs':\n",
    "    print(f'Loading from GCS: gs://{GCS_BUCKET}/{GCS_PREFIX}/sharded/')\n",
    "    data = load_data_from_gcs(GCS_BUCKET, GCS_PREFIX)\n",
    "else:\n",
    "    print(f'Loading from local: {LOCAL_DATA_DIR}')\n",
    "    data = load_data_from_local(LOCAL_DATA_DIR)\n",
    "\n",
    "# Verify all splits loaded\n",
    "assert len(data) == 3, f'Expected 3 splits (train/dev/test), got {len(data)}'\n",
    "train_df = data['train']\n",
    "dev_df = data['dev']\n",
    "test_df = data['test']\n",
    "\n",
    "print(f'\\n✓ All splits loaded successfully')\n",
    "print(f'  Train: {len(train_df)} rows')\n",
    "print(f'  Dev:   {len(dev_df)} rows')\n",
    "print(f'  Test:  {len(test_df)} rows')\n",
    "print(f'  Total: {len(train_df) + len(dev_df) + len(test_df)} rows')"
   ]
  },
