    "## Cell 7: Tabular Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('\\n=== TABULAR FEATURE ENGINEERING ===\\n')\n",
    "\n",
    "# Separate processing for train (fit) and dev/test (transform)\n",
    "def engineer_features(df, fit_df=None, scaler=None, encoders=None):\n",
    "    \"\"\"\n",
    "    Engineer tabular features:\n",
    "    1. Age: Impute missing with median, z-score normalize\n",
    "    2. Sex: Fill missing with 'unknown', one-hot encode\n",
    "    3. Localization: Fill missing with 'unknown', one-hot encode\n",
    "    \n",
    "    Args:\n",
    "        df: DataFrame to transform\n",
    "        fit_df: DataFrame to fit scaler/encoders (usually training set)\n",
    "        scaler: Pre-fitted StandardScaler (if None, will be created)\n",
    "        encoders: Dict of pre-fitted OneHotEncoders (if None, will be created)\n",
    "    \n",
    "    Returns:\n",
    "        features_df: DataFrame with engineered features\n",
    "        scaler, encoders: Fitted objects for reuse on dev/test\n",
    "    \"\"\"\n",
    "    features_df = df.copy()\n",
    "    \n",
    "    # === AGE ===\n",
    "    if fit_df is not None and scaler is None:\n",
    "        # Fit on training data\n",
    "        age_median = fit_df['age'].median()\n",
    "    else:\n",
    "        age_median = features_df['age'].median()\n",
    "    \n",
    "    # Impute missing with median\n",
    "    features_df['age'] = features_df['age'].fillna(age_median)\n",
    "    \n",
    "    # Z-score normalize\n",
    "    if scaler is None:\n",
    "        scaler = StandardScaler()\n",
    "        scaler.fit(fit_df[['age']] if fit_df is not None else features_df[['age']])\n",
    "    \n",
    "    features_df['age_scaled'] = scaler.transform(features_df[['age']])\n",
    "    \n",
    "    # === SEX ===\n",
    "    features_df['sex'] = features_df['sex'].fillna('unknown')\n",
    "    \n",
    "    # === LOCALIZATION ===\n",
    "    features_df['localization'] = features_df['localization'].fillna('unknown')\n",
    "    \n",
    "    # === ONE-HOT ENCODING ===\n",
    "    if encoders is None:\n",
    "        encoders = {}\n",
    "        # Fit on all categories from training data\n",
    "        fit_data = fit_df if fit_df is not None else features_df\n",
    "        for col in ['sex', 'localization']:\n",
    "            enc = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\n",
    "            enc.fit(fit_data[[col]])\n",
    "            encoders[col] = enc\n",
    "    \n",
    "    # Transform\n",
    "    feature_cols = []\n",
    "    for col in ['sex', 'localization']:\n",
    "        encoded = encoders[col].transform(features_df[[col]])\n",
    "        categories = encoders[col].categories_[0]\n",
    "        col_names = [f'{col}_{cat}' for cat in categories]\n",
    "        for i, col_name in enumerate(col_names):\n",
    "            features_df[col_name] = encoded[:, i]\n",
    "        feature_cols.extend(col_names)\n",
    "    \n",
    "    # Combine into feature matrix\n",
    "    feature_cols = ['age_scaled'] + feature_cols\n",
    "    X = features_df[feature_cols].copy()\n",
    "    \n",
    "    return X, scaler, encoders, feature_cols\n",
    "\n",
    "print('✓ Feature engineering function defined')\n",
    "print('\\nEngineering features...')"
   ]
  },
