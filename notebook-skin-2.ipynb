    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "IMAGE_HEIGHT = config.get('image', {}).get('target_height', 224)\n",
    "IMAGE_WIDTH = config.get('image', {}).get('target_width', 224)\n",
    "IMAGE_CHANNELS = config.get('image', {}).get('channels', 3)\n",
    "\n",
    "print(f'✓ Configuration initialized')\n",
