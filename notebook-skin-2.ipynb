   "source": [
    "## Cell 4: Validation (Schema & Constraints)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def validate_data(df_dict, config):\n",
    "    \"\"\"Validate schema, constraints, and integrity.\"\"\"\n",
    "    print('\\n=== Data Validation ===' )\n",
    "    errors = []\n",
    "    warnings_list = []\n",
    "    \n",
    "    required_fields = config.get('validation', {}).get('required_fields', \n",
    "        ['image_id', 'lesion_id', 'label', 'age', 'sex', 'localization'])\n",
    "    \n",
    "    for split_name, df in df_dict.items():\n",
    "        print(f'\\nValidating {split_name.upper()}:')\n",
    "        \n",
    "        # Check required fields\n",
    "        for field in required_fields:\n",
    "            if field not in df.columns:\n",
    "                errors.append(f'{split_name}: Missing required field \"{field}\"')\n",
    "            else:\n",
    "                print(f'  ✓ {field} present')\n",
    "        \n",
    "        # Type checks\n",
    "        if 'label' in df.columns:\n",
    "            if not df['label'].dtype in [int, 'int32', 'int64']:\n",
    "                errors.append(f'{split_name}: label should be int, got {df[\"label\"].dtype}')\n",
    "            if not set(df['label'].unique()).issubset({0, 1}):\n",
    "                errors.append(f'{split_name}: label contains values other than 0 or 1')\n",
    "        \n",
    "        # Value range checks\n",
    "        if 'age' in df.columns:\n",
    "            invalid_ages = df[(df['age'] < 0) | (df['age'] > 150)]['age'].count()\n",
    "            if invalid_ages > 0:\n",
    "                warnings_list.append(f'{split_name}: {invalid_ages} invalid ages (not in 0-150 range)')\n",
    "        \n",
    "        # No duplicates across image_id\n",
    "        if 'image_id' in df.columns:\n",
    "            dup_count = df['image_id'].duplicated().sum()\n",
    "            if dup_count > 0:\n",
    "                errors.append(f'{split_name}: {dup_count} duplicate image_ids')\n",
    "            else:\n",
    "                print(f'  ✓ No duplicate image_ids')\n",
    "    \n",
    "    # Check leakage across splits\n",
    "    print('\\nChecking leakage across splits:')\n",
    "    if 'lesion_id' in train_df.columns:\n",
    "        train_lesions = set(train_df['lesion_id'].unique())\n",
    "        dev_lesions = set(dev_df['lesion_id'].unique())\n",
    "        test_lesions = set(test_df['lesion_id'].unique())\n",
    "        \n",
    "        if train_lesions & dev_lesions:\n",
    "            errors.append(f'Leakage: {len(train_lesions & dev_lesions)} lesions in both train and dev')\n",
    "        else:\n",
    "            print('  ✓ No lesion overlap: train ∩ dev = ∅')\n",
    "        \n",
    "        if train_lesions & test_lesions:\n",
    "            errors.append(f'Leakage: {len(train_lesions & test_lesions)} lesions in both train and test')\n",
    "        else:\n",
    "            print('  ✓ No lesion overlap: train ∩ test = ∅')\n",
    "        \n",
    "        if dev_lesions & test_lesions:\n",
    "            errors.append(f'Leakage: {len(dev_lesions & test_lesions)} lesions in both dev and test')\n",
    "        else:\n",
    "            print('  ✓ No lesion overlap: dev ∩ test = ∅')\n",
    "    \n",
    "    # Report\n",
    "    print(f'\\n=== Validation Summary ===')\n",
    "    if errors:\n",
    "        print('✗ ERRORS:')\n",
    "        for e in errors:\n",
    "            print(f'  {e}')\n",
    "    else:\n",
    "        print('✓ No critical errors')\n",
    "    \n",
    "    if warnings_list:\n",
    "        print('⚠ Warnings:')\n",
    "        for w in warnings_list:\n",
    "            print(f'  {w}')\n",
    "    \n",
    "    assert not errors, f'Validation failed with {len(errors)} errors'\n",
    "    print('\\n✓ Validation passed')\n",
    "\n",
    "validate_data({'train': train_df, 'dev': dev_df, 'test': test_df}, config)"
   ]
  },
