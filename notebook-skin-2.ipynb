    "## Cell 6: Image Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('\\n=== IMAGE PREPROCESSING ===\\n')\n",
    "\n",
    "def preprocess_image(img, target_height=224, target_width=224, normalize=True):\n",
    "    \"\"\"\n",
    "    Preprocess a single image: load, resize, normalize.\n",
    "    \n",
    "    Args:\n",
    "        img: PIL Image or bytes\n",
    "        target_height, target_width: Target dimensions\n",
    "        normalize: Whether to normalize to [0, 1]\n",
    "    \n",
    "    Returns:\n",
    "        np.ndarray of shape (height, width, 3) with float32 type\n",
    "    \"\"\"\n",
    "    try:\n",
    "        # Convert bytes to PIL Image if needed\n",
    "        if isinstance(img, bytes):\n",
    "            from io import BytesIO\n",
    "            img = Image.open(BytesIO(img))\n",
    "        elif not isinstance(img, Image.Image):\n",
    "            return None\n",
    "        \n",
    "        # Convert to RGB if necessary\n",
    "        if img.mode != 'RGB':\n",
    "            img = img.convert('RGB')\n",
    "        \n",
    "        # Resize: preserve aspect ratio, pad if necessary\n",
    "        img.thumbnail((target_width, target_height), Image.Resampling.LANCZOS)\n",
    "        \n",
    "        # Create new image with target size and paste resized image\n",
    "        new_img = Image.new('RGB', (target_width, target_height), color=(0, 0, 0))\n",
    "        offset = ((target_width - img.width) // 2, (target_height - img.height) // 2)\n",
    "        new_img.paste(img, offset)\n",
    "        \n",
    "        # Convert to numpy array\n",
    "        arr = np.array(new_img, dtype=np.float32)\n",
    "        \n",
    "        # Normalize to [0, 1]\n",
    "        if normalize:\n",
    "            arr = arr / 255.0\n",
    "        \n",
    "        return arr\n",
    "    except Exception as e:\n",
    "        print(f'Error preprocessing image: {str(e)[:100]}')\n",
    "        return None\n",
    "\n",
    "print('✓ Image preprocessing function defined')\n",
    "print(f'  Target size: {IMAGE_HEIGHT}×{IMAGE_WIDTH}×{IMAGE_CHANNELS}')\n",
    "print(f'  Normalization: {config.get(\"image\", {}).get(\"normalize\", True)}')"
   ]
  },
