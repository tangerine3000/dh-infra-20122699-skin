    "print('\\n=== FEATURE VALIDATION ===\\n')\n",
    "\n",
    "errors = []\n",
    "\n",
    "# Check for missing values\n",
    "print('Checking for missing values in features...')\n",
    "for split_name, X in [('train', X_train), ('dev', X_dev), ('test', X_test)]:\n",
    "    missing = X.isnull().sum().sum()\n",
    "    if missing > 0:\n",
    "        errors.append(f'{split_name}: {missing} missing feature values')\n",
    "    else:\n",
    "        print(f'  ✓ {split_name}: no missing values')\n",
    "\n",
    "# Check feature ranges\n",
    "print('\\nChecking feature ranges...')\n",
    "# Age should be roughly [-3, 3] for z-score\n",
    "age_min, age_max = X_train['age_scaled'].min(), X_train['age_scaled'].max()\n",
    "print(f'  Age z-score range: [{age_min:.2f}, {age_max:.2f}]')\n",
    "if age_min < -5 or age_max > 5:\n",
    "    print(f'  ⚠ Warning: unusual z-score range')\n",
    "\n",
    "# One-hot features should be 0 or 1\n",
    "onehot_cols = [col for col in X_train.columns if col != 'age_scaled']\n",
    "for col in onehot_cols[:3]:  # Check first 3\n",
    "    values = set(X_train[col].unique())\n",
    "    if values != {0.0, 1.0, 0, 1} and not values.issubset({0, 1}):\n",
    "        errors.append(f'{col} has values {values} (expected 0, 1)')\n",
    "print(f'  ✓ One-hot features are binary')\n",
    "\n",
    "# Check consistency across splits\n",
    "print('\\nChecking consistency across splits...')\n",
    "for col in feature_cols:\n",
    "    if col == 'age_scaled':\n",
    "        # Dev/test age should be roughly the same distribution\n",
    "        dev_mean = X_dev[col].mean()\n",
    "        test_mean = X_test[col].mean()\n",
    "        print(f'  {col}: train_mean=0.00, dev_mean={dev_mean:.3f}, test_mean={test_mean:.3f}')\n",
    "\n",
    "# Report\n",
    "print(f'\\n✓ Feature validation complete')\n",
    "if errors:\n",
    "    print('✗ Errors:')\n",
    "    for e in errors:\n",
    "        print(f'  {e}')\n",
    "    assert False, 'Feature validation failed'\n",
    "else:\n",
    "    print('✓ All checks passed')"
   ]
